# Agent envs
PORT=8080
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# ── AP2 checkout tools ────────────────────────────────────────────────────────
# The three AP2 entity Function URLs the agent's propose-only tools call over SigV4. The CDK app
# injects all three; set them here only to exercise the tools locally against a deployed stack.
# The tools register only when ALL THREE are present — an unconfigured run offers none of them
# rather than offering tools that fail on every call. The MPP is absent by design: the Merchant
# drives it, so the agent has no path to settlement.
# MERCHANT_URL=
# CONSENT_URL=
# CP_URL=

# Disables TLS certificate verification for the WHOLE process — SigV4 calls to the AP2 entities and
# to Bedrock included, not just the one connection you had in mind. Left commented on purpose: this
# file is meant to be copied to .env verbatim, and an agent that moves money must not be MITM-able by
# default. Uncomment only if you know exactly which connection needs it, and put it back afterwards.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Invoke script envs (npm run invoke:bedrock)
# AWS_REGION is already defined above, but you can override it here if needed.
# The script signs with SigV4 from your ambient AWS profile — the only way into the runtime, which
# carries no JWT authorizer. Your profile needs bedrock-agentcore:InvokeAgentRuntime on this ARN.
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/my-agent-service-XXXXXXXXXX
