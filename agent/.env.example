# Agent envs
PORT=8080
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Ceiling on a single /invocations body, in characters. The BFF's own MAX_MESSAGE_LENGTH already
# bounds what reaches here and the BFF is the runtime's only caller, so this is the ceiling that
# holds if anything ever invokes the runtime directly. Default 20000.
# MAX_BODY_LENGTH=20000

# Disables TLS certificate verification for the WHOLE process — the calls to Bedrock included, not
# just the one connection you had in mind. Left commented on purpose: this file is meant to be
# copied to .env verbatim. Uncomment only if you know exactly which connection needs it, and put it
# back afterwards.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Invoke script envs (npm run invoke:bedrock)
# AWS_REGION is already defined above, but you can override it here if needed.
# The script signs with SigV4 from your ambient AWS profile — the only way into the runtime, which
# carries no JWT authorizer. Your profile needs bedrock-agentcore:InvokeAgentRuntime on this ARN.
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/my-agent-service-XXXXXXXXXX
