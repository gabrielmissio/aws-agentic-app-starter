{
  "name": "agent",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "dev": "npm run build && dotenvx run -f .env --overload -- node dist/index.js",
    "invoke:bedrock": "dotenvx run -f .env --overload -- tsx src/invoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1156.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1156.0",
    "@aws-sdk/credential-provider-node": "^3.972.81",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^2.8.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.79.0",
    "@opentelemetry/otlp-transformer": "^0.300.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@smithy/signature-v4": "^5.7.3",
    "@strands-agents/sdk": "1.22.0",
    "express": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
