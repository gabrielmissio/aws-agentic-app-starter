{
  "name": "agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "dev": "npm run build && dotenvx run -f .env --overload -- node dist/index.js",
    "invoke:bedrock": "dotenvx run -f .env --overload -- tsx src/invoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1118.0",
    "@strands-agents/sdk": "1.14.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
