# ap2-core — the environment the five entity Lambdas consume. The CDK app injects all of these in a
# deployed environment; you only need this file to run `npm run seed` from your own machine.
#
# Nothing here is required for `npm test`: the test suite runs the whole AP2 chain against the
# in-memory adapters and a local ES256 signer, with no AWS account involved.

AWS_REGION=us-east-1

# KMS — one signing key per entity (ARNs; see infra/src/stacks/security-stack.ts).
KMS_KEY_MERCHANT=
KMS_KEY_CONSENT=
KMS_KEY_CP=
KMS_KEY_MPP=

# DynamoDB table names (see infra/src/stacks/data-stack.ts).
# Format: ${PROJECT_NAME}-<suffix>, e.g. demo-strands-agents-ts-merchant-catalog
TABLE_CATALOG=
TABLE_CARTS=
TABLE_CONSENT_SESSIONS=
TABLE_MANDATES=
TABLE_PM_REGISTRY=
TABLE_CREDENTIALS=
TABLE_PAYMENT_ATTEMPTS=
TABLE_EVIDENCE=

# The MPPs a credential may be scoped to, and the private Function URL the MPP calls to redeem.
ALLOWED_MPPS=mpp-sandbox-001
CP_ENDPOINT=

# Mint a sandbox payment method for a user who has none, on first listing.
AUTO_PROVISION_SANDBOX_METHOD=true

# `npm run seed` only: seeds a sandbox payment method for this Cognito sub. Leave unset to seed the
# catalog alone (AUTO_PROVISION_SANDBOX_METHOD covers per-user methods).
# SEED_USER_ID=
