{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ap2:cart_mandate",
  "title": "CartMandate",
  "description": "Merchant-signed cart. Source: AP2 ap2.models.mandate.{CartMandate,CartContents}.",
  "type": "object",
  "required": ["contents", "merchant_authorization"],
  "properties": {
    "contents": {
      "type": "object",
      "required": [
        "id",
        "user_cart_confirmation_required",
        "payment_request",
        "cart_expiry",
        "merchant",
        "merchant_name"
      ],
      "properties": {
        "id": { "type": "string" },
        "user_cart_confirmation_required": { "type": "boolean" },
        "payment_request": { "$ref": "ap2:payment_request" },
        "cart_expiry": { "type": "string" },
        "merchant": {
          "type": "object",
          "required": ["id", "name"],
          "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "website": { "type": "string" } }
        },
        "merchant_name": { "type": "string" }
      }
    },
    "merchant_authorization": {
      "type": "string",
      "description": "base64url compact JWT (JWS) signing cart_hash = hash(contents)."
    }
  }
}
