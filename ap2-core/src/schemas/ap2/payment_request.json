{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ap2:payment_request",
  "title": "PaymentRequest",
  "description": "W3C Payment Request. Source: AP2 ap2.models.payment_request.PaymentRequest.",
  "type": "object",
  "required": ["method_data", "details"],
  "properties": {
    "method_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["supported_methods"],
        "properties": { "supported_methods": { "type": "string" }, "data": { "type": "object" } }
      }
    },
    "details": {
      "type": "object",
      "required": ["id", "display_items", "total"],
      "properties": {
        "id": { "type": "string" },
        "display_items": { "type": "array", "items": { "$ref": "ap2:types/payment_item" } },
        "total": { "$ref": "ap2:types/payment_item" }
      }
    },
    "options": { "type": "object" }
  }
}
