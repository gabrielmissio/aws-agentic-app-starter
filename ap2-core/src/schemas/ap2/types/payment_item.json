{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ap2:types/payment_item",
  "title": "PaymentItem",
  "description": "W3C Payment Request item. Source: AP2 ap2.models.payment_request.PaymentItem.",
  "type": "object",
  "required": ["label", "amount"],
  "properties": {
    "label": { "type": "string" },
    "amount": { "$ref": "ap2:types/amount" },
    "pending": { "type": "boolean" },
    "refund_period": { "type": "number" }
  }
}
