PORT=3001
AWS_REGION=us-east-1
ALLOWED_ORIGIN=*
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/my-agent-service-XXXXXXXXXX

# Per-caller quota on /chat, and the window in seconds. Set by the CDK app when deployed; unset
# locally, where there is no DynamoDB table to meter against and the check is skipped.
# USER_RATE_LIMIT=20
# USER_RATE_LIMIT_WINDOW_SECONDS=60

# The AgentCore Memory resource and the conversation index table, both set by the CDK app when
# deployed. Unset locally: the chat still works and the agent still answers, but no conversation is
# recorded and the sidebar stays empty — the same treatment as the rate limit above.
# AGENTCORE_MEMORY_ID=my_project_memory-XXXXXXXXXX
# CONVERSATION_TABLE_NAME=my-project-conversations

# How long a conversation is kept. Must match `eventExpiryDuration` on the memory resource: this
# value only sets the TTL on the index rows, and an index that outlives the conversations it points
# at fills the sidebar with entries that open empty. Default 30.
# CONVERSATION_RETENTION_DAYS=30
