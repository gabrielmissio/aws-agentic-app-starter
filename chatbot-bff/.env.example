PORT=3001
AWS_REGION=us-east-1
ALLOWED_ORIGIN=*
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/my-agent-service-XXXXXXXXXX

# Local development only — allows self-signed certificates. Disables TLS verification for the whole
# process, so never carry it into a deployed configuration.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Per-caller quota on /chat, and the window in seconds. Set by the CDK app when deployed; unset
# locally, where there is no DynamoDB table to meter against and the check is skipped.
# USER_RATE_LIMIT=20
# USER_RATE_LIMIT_WINDOW_SECONDS=60
