
PORT=3001
AWS_REGION=us-east-1
ALLOWED_ORIGIN=*
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:YOUR_ACCOUNT_ID:runtime/my-agent-service-XXXXXXXXXX
# NODE_TLS_REJECT_UNAUTHORIZED=0 # Local development only - allows self-signed certificates
# ── AP2 checkout (the ap2-handler routes) ─────────────────────────────────────
# Only needed to run the checkout handler locally against a deployed stack. `npm run dev` serves
# /chat alone, so none of this is required for the default local loop.
#
# INTENTS_TABLE=
# EVIDENCE_TABLE=
# HMAC_SECRET_ARN=
# MERCHANT_URL=
# CONSENT_URL=
# The Mandate Authority's own URL — only this Lambda is granted invoke on it.
# CONSENT_DECISION_URL=
# CP_URL=
# KMS_KEY_MERCHANT=
# KMS_KEY_CONSENT=
# KMS_KEY_CP=
# KMS_KEY_MPP=
# Signed, not read: the BFF is the only holder of kms:Sign on this one.
# KMS_KEY_IDENTITY=
# INTENT_TTL_MIN=5
# OTP_STEPUP_THRESHOLD_CENTS=10000
# OTP_REVEAL_IN_UI=false
