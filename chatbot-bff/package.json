  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.61.0",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
