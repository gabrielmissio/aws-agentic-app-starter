# ── BFF ───────────────────────────────────────────────────────────────
# Base URL for every call the browser makes: the chat stream (/chat) and the admin routes
# (/admin/users). There is no second transport — the browser never reaches the AgentCore runtime,
# which accepts SigV4 from the BFF alone.
VITE_API_URL=/api

# ── Cognito sign-in ───────────────────────────────────────────────────
# User pool only. No identity pool: nothing in the browser calls an AWS API directly, so there is no
# reason to vend it AWS credentials.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=

# ── Sign-up mode ──────────────────────────────────────────────────────
# Mirrors PUBLIC_SIGNUP_ENABLED in infra/.env.example. In a deployed environment this is injected
# at deploy time via config.js — set here only to preview the invite-only auth screen locally.
# VITE_PUBLIC_SIGNUP_ENABLED=false

# ── Second factor ─────────────────────────────────────────────────────
# Mirrors COGNITO_MFA in infra/.env.example: off | optional | required. Injected at deploy time via
# config.js — set here only to preview the enrollment flows locally.
# VITE_COGNITO_MFA=optional
