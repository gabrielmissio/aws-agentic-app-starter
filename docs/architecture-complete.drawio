        <mxCell id="st_auth" value="auth stack" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#DD344C;fontColor=#DD344C;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1050" y="220" width="740" height="400" as="geometry" />
        </mxCell>
        <mxCell id="st_edge" value="Edge protection — WAFv2 web ACL" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#DD344C;fontColor=#DD344C;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1830" y="220" width="820" height="400" as="geometry" />
        </mxCell>
        <mxCell id="st_bff" value="bff stack — API Gateway + the Trusted Surface" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="680" width="1520" height="460" as="geometry" />
        </mxCell>
        <mxCell id="st_agent" value="agent stack — Bedrock AgentCore" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#01A88D;fontColor=#01A88D;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1830" y="680" width="820" height="460" as="geometry" />
        </mxCell>
        <mxCell id="st_ap2" value="ap2 stack — AP2 entities · every endpoint is a Lambda Function URL with AuthType=AWS_IAM · Node.js 22 · 256 MB · 15 s · X-Ray active" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#ED7100;fontColor=#ED7100;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="1280" width="2380" height="400" as="geometry" />
        </mxCell>
        <mxCell id="st_data" value="data stack — Amazon DynamoDB · PAY_PER_REQUEST + point-in-time recovery on every table · no streams" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#C925D1;fontColor=#C925D1;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="1740" width="2380" height="340" as="geometry" />
        </mxCell>
        <mxCell id="st_security" value="security stack — AWS KMS asymmetric signing keys (ECC_NIST_P256 / ES256)" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#DD344C;fontColor=#DD344C;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="2140" width="2380" height="300" as="geometry" />
        </mxCell>
        <mxCell id="st_ops" value="Observability, alerting and cost guardrails" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#E7157B;fontColor=#E7157B;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="2500" width="2380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="title" value="AP2 Agentic Payments on AWS — complete solution architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="200" y="50" width="1700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Seven CDK stacks · the agent proposes and never pays · every AP2 artifact is a KMS-signed, independently verifiable credential" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5A6C74;" vertex="1" parent="1">
          <mxGeometry x="200" y="92" width="1900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="user" value='&lt;b&gt;User&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;browser / SPA&lt;br&gt;ID token held in memory&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.authenticated_user;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="cloudfront" value='&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;SPA distribution · PRICE_CLASS_100&lt;br&gt;CSP + HSTS response headers policy&lt;br&gt;403/404 &amp;#8594; /index.html&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1">
          <mxGeometry x="320" y="300" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s3" value='&lt;b&gt;Amazon S3&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;frontend assets bucket&lt;br&gt;private — reachable only via OAC&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ssm" value='&lt;b&gt;Systems Manager&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;Parameter Store&lt;br&gt;/&amp;lt;project&amp;gt;/app-url&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1">
          <mxGeometry x="800" y="300" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="waf_cf" value='&lt;b&gt;AWS WAF — absent&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;no CLOUDFRONT-scoped web ACL&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;opacity=35;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_front" value="&lt;b&gt;Gap.&lt;/b&gt; A CloudFront-scoped web ACL is a different door from the API one, and AWS requires it to be created in the &lt;b&gt;Global (CloudFront) Region — us-east-1&lt;/b&gt;. The stack sets no &lt;i&gt;webAclId&lt;/i&gt; on the distribution, so the SPA edge is unprotected even when &lt;i&gt;WAF_ENABLED=true&lt;/i&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="470" y="470" width="510" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value='&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;User Pool — email sign-in, SRP&lt;br&gt;TOTP MFA · threat protection (PLUS)&lt;br&gt;ID token 1 h · refresh 30 d&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1">
          <mxGeometry x="1100" y="300" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="cognito_client" value='&lt;b&gt;User Pool Client&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;web client — no secret&lt;br&gt;&lt;i&gt;admins&lt;/i&gt; group, precedence 0&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.authenticated_user;" vertex="1" parent="1">
          <mxGeometry x="1340" y="300" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="custom_msg" value='&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;custom-message trigger&lt;br&gt;Node.js 22 · 128 MB · 5 s&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1580" y="300" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_auth" value="&lt;b&gt;There is no Cognito Identity Pool&lt;/b&gt; — the browser never receives AWS credentials, and a synth test asserts its absence. Sign-in yields an &lt;b&gt;ID token&lt;/b&gt;, which is exactly what the API Gateway authorizer is configured to accept (declaring no &lt;i&gt;authorizationScopes&lt;/i&gt; is what makes it an ID-token authorizer)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1100" y="470" width="640" height="110" as="geometry" />
        </mxCell>
        <mxCell id="waf_rules" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.filtering_rule;" vertex="1" parent="1">
          <mxGeometry x="1875" y="290" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_waf" value="&lt;b&gt;wafv2.CfnWebACL&lt;/b&gt; &amp;#8212; &lt;i&gt;&amp;lt;project&amp;gt;-api-acl&lt;/i&gt;, scope &lt;b&gt;REGIONAL&lt;/b&gt;, default action &lt;i&gt;allow&lt;/i&gt;, associated with the &lt;b&gt;prod&lt;/b&gt; stage of the REST API. AWS requires a Regional WAFV2 web ACL for an API Gateway stage.&lt;br&gt;&lt;br&gt;&lt;b&gt;Rules — every one blocks; none is in count mode:&lt;/b&gt;&lt;br&gt;&amp;#8226;&amp;nbsp;10&amp;nbsp; AWSManagedRulesAmazonIpReputationList&lt;br&gt;&amp;#8226;&amp;nbsp;20&amp;nbsp; AWSManagedRulesKnownBadInputsRuleSet&lt;br&gt;&amp;#8226;&amp;nbsp;30&amp;nbsp; AWSManagedRulesCommonRuleSet&lt;br&gt;&amp;#8226;&amp;nbsp;40&amp;nbsp; RateLimitPerIp — rate-based, 1000 req / IP&lt;br&gt;&lt;br&gt;&lt;b&gt;Off by default&lt;/b&gt; (&lt;i&gt;WAF_ENABLED=false&lt;/i&gt; in every profile, including &lt;i&gt;prod&lt;/i&gt;). It is the only control that acts &lt;b&gt;before authentication&lt;/b&gt;: the stage throttle is account-wide and says nothing about who is spending it, and the per-caller quota is keyed on an already-authenticated &lt;i&gt;sub&lt;/i&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1955" y="280" width="650" height="320" as="geometry" />
        </mxCell>
        <mxCell id="waf_api" value='&lt;b&gt;AWS WAF&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;web ACL &amp;#8594; prod stage&lt;br&gt;REGIONAL · conditional&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1">
          <mxGeometry x="320" y="780" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="apigw" value='&lt;b&gt;Amazon API Gateway&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;REST API · stage prod&lt;br&gt;throttle 10 rps / burst 20&lt;br&gt;JSON access logs, no payloads&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="560" y="780" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="bff_chat" value='&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;BFF Chat — POST /chat&lt;br&gt;streamed · 512 MB · 60 s&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="820" y="780" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="bff_admin" value='&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;BFF Admin — /admin/users&lt;br&gt;256 MB · 29 s&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1080" y="780" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="bff_ap2" value='&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;BFF Checkout — &lt;b&gt;Trusted Surface&lt;/b&gt;&lt;br&gt;/intent /confirm /decline&lt;br&gt;/journeys /actors /evidence&lt;br&gt;512 MB · 29 s&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1340" y="780" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ratelimit" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;bff-rate-limit&lt;br&gt;TTL · UpdateItem only&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1600" y="780" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="k_identity" value='&lt;b&gt;AWS KMS&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;Caller Identity key&lt;br&gt;the only kms:Sign holders&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="820" y="990" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="secret" value='&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;ap2-hmac-secret&lt;br&gt;seals intents · hashes OTP&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="1080" y="990" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="sns_otp" value='&lt;b&gt;Amazon SNS&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;one-time code by SMS&lt;br&gt;out of band — never via the agent&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="1340" y="990" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="intents" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;ap2-intents + 2 GSIs&lt;br&gt;byInitiator · byJourney · TTL&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1600" y="990" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_bff" value="&lt;b&gt;Three functions, not three routes on one.&lt;/b&gt; Only BFF Checkout holds the HMAC secret, &lt;i&gt;sns:Publish&lt;/i&gt; and invoke rights on the Mandate Authority; only BFF Admin holds &lt;i&gt;cognito-idp:AdminCreateUser&lt;/i&gt;. Keeping those off the role that relays model output is what makes &amp;#8220;the agent cannot move money&amp;#8221; structural rather than a matter of prompt discipline.&lt;br&gt;&lt;br&gt;&lt;b&gt;All nine business methods carry the Cognito authorizer&lt;/b&gt; (1 chat + 2 admin + 6 AP2), and a synth test asserts none can be added without one. The only unauthenticated methods are the CORS &lt;i&gt;OPTIONS&lt;/i&gt; preflights, which browsers require." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="985" width="460" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ecr" value='&lt;b&gt;Amazon ECR&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;agent container image&lt;br&gt;DockerImageAsset · arm64&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1">
          <mxGeometry x="1880" y="780" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="agentcore" value='&lt;b&gt;Bedrock AgentCore&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;Agent Runtime — Strands agent&lt;br&gt;SigV4 only, no authorizer&lt;br&gt;idle 900 s · max lifetime 14400 s&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="1">
          <mxGeometry x="2140" y="780" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="bedrock" value='&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;claude-sonnet-4-6&lt;br&gt;IAM-scoped to this one model&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="2400" y="780" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="agent_role" value='&lt;b&gt;IAM Role&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;agentcore-runtime-role&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="1">
          <mxGeometry x="2140" y="995" width="78" height="44" as="geometry" />
        </mxCell>
        <mxCell id="n_agent" value="&lt;b&gt;Propose-only tools:&lt;/b&gt; search_products, create_merchant_cart, list_payment_methods, initiate_consent_session.&lt;br&gt;&lt;br&gt;The runtime role is granted invoke on &lt;b&gt;Merchant, Consent and CP only&lt;/b&gt; — never the Mandate Authority, never the MPP. Nothing outside the BFF Chat role holds &lt;i&gt;InvokeAgentRuntime&lt;/i&gt;, so no browser can reach it." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2280" y="985" width="330" height="145" as="geometry" />
        </mxCell>
        <mxCell id="merchant" value='&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;(Merchant Endpoint)&lt;br&gt;search_products, create_merchant_cart&lt;br&gt;initiate_payment, get_payment_status&lt;br&gt;signs the CartMandate&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="340" y="1350" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="consent" value='&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;(Consent Sessions — signs nothing)&lt;br&gt;initiate_consent_session&lt;br&gt;get_consent_session&lt;br&gt;poll_consent_status&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="720" y="1350" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="mandate_authority" value='&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;(&lt;b&gt;Mandate Authority&lt;/b&gt;)&lt;br&gt;submit_consent_decision&lt;br&gt;sole kms:Sign on the Consent key&lt;br&gt;signs Checkout + Payment Mandate&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1350" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="cp" value='&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;(Credential Provider)&lt;br&gt;list_payment_methods&lt;br&gt;request_payment_credential&lt;br&gt;redeem — single-use credential&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1480" y="1350" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="mpp" value='&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;(Merchant Payment Processor)&lt;br&gt;verifies all four signatures&lt;br&gt;consumes the anti-replay nonce&lt;br&gt;signs the PaymentReceipt&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1860" y="1350" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="evidence_fn" value='&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;(Evidence Store — signs nothing)&lt;br&gt;append-only at the IAM layer&lt;br&gt;no Function URL — the BFF&lt;br&gt;reads the log directly&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="2240" y="1350" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="t_catalog" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;merchant-catalog&lt;br&gt;pk productId&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="280" y="1810" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="t_carts" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;merchant-carts&lt;br&gt;pk cartId&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="430" y="1810" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="t_sessions" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;consent-sessions&lt;br&gt;pk sessionId · TTL&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="680" y="1810" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="t_mandates" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;mandates&lt;br&gt;pk mandateId&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="820" y="1810" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="t_evidence" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;evidence-log&lt;br&gt;pk journeyId · sk&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1810" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="t_pm" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;payment-methods-registry&lt;br&gt;pk userId · sk ref&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1420" y="1810" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="t_cred" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;payment-credentials&lt;br&gt;pk credentialId · TTL&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1570" y="1810" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="t_attempts" value='&lt;b&gt;DynamoDB&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;payment-attempts&lt;br&gt;pk paymentId&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1800" y="1810" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_data" value="&lt;b&gt;evidence-log is append-only at the IAM layer.&lt;/b&gt; Every entity is granted &lt;i&gt;dynamodb:PutItem&lt;/i&gt; and nothing else on it, so an entity can add to the record of what it did and can neither amend nor erase it — the one authority an audit log must withhold.&lt;br&gt;&lt;br&gt;&lt;b&gt;payment-credentials&lt;/b&gt; also stores the anti-replay markers (&lt;i&gt;jti#&amp;lt;verifier&amp;gt;#&amp;lt;jti&amp;gt;&lt;/i&gt;), which is what its TTL prunes.&lt;br&gt;&lt;br&gt;&lt;b&gt;ap2-intents&lt;/b&gt; and &lt;b&gt;bff-rate-limit&lt;/b&gt; are owned by the bff stack and drawn there." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1960" y="1790" width="640" height="180" as="geometry" />
        </mxCell>
        <mxCell id="k_merchant" value='&lt;b&gt;AWS KMS&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;Merchant key&lt;br&gt;signed by the Merchant&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="340" y="2210" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="k_consent" value='&lt;b&gt;AWS KMS&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;Consent key&lt;br&gt;signed by the Mandate Authority&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="1100" y="2210" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="k_cp" value='&lt;b&gt;AWS KMS&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;CP key&lt;br&gt;signed by the Credential Provider&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="1480" y="2210" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="k_mpp" value='&lt;b&gt;AWS KMS&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;MPP key&lt;br&gt;signed by the MPP&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="1860" y="2210" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_kms" value="&lt;b&gt;kms:Verify&lt;/b&gt; (not drawn, to keep the picture readable) &amp;nbsp;&amp;#8226;&amp;nbsp; &lt;b&gt;Merchant&lt;/b&gt;: Consent, Identity &amp;nbsp;&amp;#8226;&amp;nbsp; &lt;b&gt;Consent Sessions&lt;/b&gt;: Identity &amp;nbsp;&amp;#8226;&amp;nbsp; &lt;b&gt;Mandate Authority&lt;/b&gt;: Merchant, Identity &amp;nbsp;&amp;#8226;&amp;nbsp; &lt;b&gt;Credential Provider&lt;/b&gt;: Merchant, Consent, CP, Identity &amp;nbsp;&amp;#8226;&amp;nbsp; &lt;b&gt;MPP&lt;/b&gt;: all four artifact keys — it is the last verifier before money moves.&lt;br&gt;&lt;b&gt;kms:Sign&lt;/b&gt; is held only by the entity that owns the key, plus the two BFF functions on the Caller Identity key (drawn in the bff stack, beside its only two signers). &lt;b&gt;The agent holds none.&lt;/b&gt; BFF Checkout additionally holds &lt;i&gt;kms:GetPublicKey&lt;/i&gt; on the four artifact keys, to publish them at &lt;i&gt;/actors&lt;/i&gt; so an outside party can verify the chain itself." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="2320" width="2260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cloudwatch" value='&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;4 alarms&lt;br&gt;3 BFF Lambdas + API 5XX&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="1">
          <mxGeometry x="340" y="2570" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="cw_logs" value='&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;one group per function&lt;br&gt;1-month retention&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.cloudwatch_logs;" vertex="1" parent="1">
          <mxGeometry x="580" y="2580" width="78" height="58" as="geometry" />
        </mxCell>
        <mxCell id="xray" value='&lt;b&gt;AWS X-Ray&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;active on the six entities&lt;br&gt;and the agent runtime&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;" vertex="1" parent="1">
          <mxGeometry x="820" y="2570" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="sns_alarms" value='&lt;b&gt;Amazon SNS&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;alarm topic&lt;br&gt;&amp;#8594; e-mail&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="1060" y="2570" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="budgets" value='&lt;b&gt;AWS Budgets&lt;/b&gt;&lt;div style="font-size:9px;line-height:12px"&gt;monthly COST budget&lt;br&gt;notifies at 80% and 100%&lt;/div&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets_2;" vertex="1" parent="1">
          <mxGeometry x="1300" y="2570" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="legend" value='&lt;b&gt;Legend&lt;/b&gt; &amp;nbsp;&amp;nbsp;&lt;font color="#232F3E"&gt;&lt;b&gt;&amp;#9473;&amp;#9473;&lt;/b&gt;&lt;/font&gt; request path (synchronous) &amp;nbsp;&amp;nbsp;&lt;font color="#879196"&gt;&lt;b&gt;&amp;#9476;&amp;#9476;&lt;/b&gt;&lt;/font&gt; configuration / trust &amp;nbsp;&amp;nbsp;&lt;font color="#C925D1"&gt;&lt;b&gt;&amp;#9473;&amp;#9473;&lt;/b&gt;&lt;/font&gt; DynamoDB access&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color="#DD344C"&gt;&lt;b&gt;&amp;#9473;&amp;#9473;&lt;/b&gt;&lt;/font&gt; KMS / Secrets Manager &amp;nbsp;&amp;nbsp;&lt;font color="#E7157B"&gt;&lt;b&gt;&amp;#9476;&amp;#9476;&lt;/b&gt;&lt;/font&gt; telemetry &amp;#8594; alert &amp;nbsp;&amp;nbsp;&lt;font color="#B0B7BA"&gt;&lt;b&gt;&amp;#9476;&amp;#9476;&lt;/b&gt;&lt;/font&gt; not deployed, shown as a gap&lt;br&gt;&lt;br&gt;&lt;b&gt;Asynchronous paths are the exception here:&lt;/b&gt; the SMS one-time code, CloudWatch alarms &amp;#8594; SNS &amp;#8594; e-mail, Budgets &amp;#8594; e-mail, and DynamoDB TTL expiry. There is &lt;b&gt;no SQS, no DLQ, no EventBridge, no Step Functions, no DynamoDB stream and no VPC&lt;/b&gt; anywhere in the deployment — every hop above is a synchronous, SigV4-signed call.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not drawn:&lt;/b&gt; the CDK bootstrap asset bucket and the two BucketDeployment custom resources. &lt;b&gt;Deployment posture&lt;/b&gt; (&lt;i&gt;demo&lt;/i&gt; / &lt;i&gt;pilot&lt;/i&gt; / &lt;i&gt;prod&lt;/i&gt;) is asserted by &lt;i&gt;assertDeploymentPosture&lt;/i&gt; at synth time, before a single construct is instantiated.' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1560" y="2550" width="1040" height="210" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="loads the SPA (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#232F3E;strokeWidth=1.6;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="cloudfront">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="origin — OAC, SigV4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#232F3E;strokeWidth=1.6;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cloudfront" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="sign in (SRP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#232F3E;strokeWidth=1.6;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="cognito">
