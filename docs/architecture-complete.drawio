<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="ap2-architecture-complete" name="Complete Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="2950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
