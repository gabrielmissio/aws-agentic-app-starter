          <mxGeometry x="230" y="185" width="2450" height="2640" as="geometry" />
        </mxCell>
        <mxCell id="st_frontend" value="frontend stack" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;container=0;pointerEvents=0;" vertex="1" parent="1">
