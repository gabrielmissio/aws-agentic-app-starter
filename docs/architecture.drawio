        <!-- ═══════════════ Notes ═══════════════ -->
        <mxCell id="notegrants" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;kms:Verify grants&lt;/b&gt; (not drawn as edges)&lt;br&gt;&lt;br&gt;&lt;b&gt;Merchant&lt;/b&gt; — Consent, Identity&lt;br&gt;&lt;b&gt;Consent Sessions&lt;/b&gt; — Identity&lt;br&gt;&lt;b&gt;Mandate Authority&lt;/b&gt; — Merchant&lt;br&gt;&lt;b&gt;Credential Provider&lt;/b&gt; — Merchant, Consent, CP, Identity&lt;br&gt;&lt;b&gt;MPP&lt;/b&gt; — Merchant, Consent, CP, MPP&lt;br&gt;&lt;br&gt;&lt;b&gt;kms:Sign&lt;/b&gt; is held only by the entity that owns the key, plus the two BFF functions on the Identity key. The agent holds none.&lt;br&gt;&lt;br&gt;&lt;b&gt;BFF Checkout&lt;/b&gt; additionally holds &lt;i&gt;kms:GetPublicKey&lt;/i&gt; on the four artifact keys, to publish them at /actors.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#DD344C;fillColor=none;align=left;verticalAlign=top;rounded=1;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1880" y="180" width="300" height="290" as="geometry" />
        </mxCell>
        <mxCell id="notestacks" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Seven CDK stacks&lt;/b&gt;&lt;br&gt;&lt;i&gt;auth&lt;/i&gt; · &lt;i&gt;data&lt;/i&gt; · &lt;i&gt;security&lt;/i&gt; · &lt;i&gt;ap2&lt;/i&gt; · &lt;i&gt;agent&lt;/i&gt; · &lt;i&gt;bff&lt;/i&gt; · &lt;i&gt;frontend&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Not drawn:&lt;/b&gt; a CloudWatch log group per function, X-Ray active tracing on the six entity Lambdas, and the CDK bootstrap asset bucket.&lt;br&gt;&lt;br&gt;&lt;b&gt;There is no Cognito Identity Pool&lt;/b&gt; — the browser never receives AWS credentials, and a synth test asserts its absence.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#232F3E;fillColor=none;align=left;verticalAlign=top;rounded=1;fontSize=10;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1">
