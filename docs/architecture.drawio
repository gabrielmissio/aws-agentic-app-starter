<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="ap2-architecture" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════════ Containers ═══════════════ -->
        <mxCell id="aws" value="AWS Account" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2160" height="1400" as="geometry" />
        </mxCell>

        <mxCell id="entgrp" value="&lt;b&gt;AP2 entities&lt;/b&gt; — one Lambda, one IAM role, one KMS key each.&lt;br&gt;Every endpoint is a Function URL with AuthType=AWS_IAM: no public route." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="300" width="340" height="1080" as="geometry" />
        </mxCell>

        <!-- ═══════════════ User ═══════════════ -->
        <mxCell id="user" value="" style="shape=actor;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-90" y="540" width="40" height="60" as="geometry" />
        </mxCell>
        <mxCell id="userlbl" value="User&lt;br&gt;(browser)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-115" y="605" width="90" height="30" as="geometry" />
        </mxCell>

        <!-- ═══════════════ Frontend & Auth ═══════════════ -->
        <mxCell id="cf" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;div&gt;(Frontend Distribution&lt;br&gt;+ CSP / HSTS headers)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1">
          <mxGeometry x="120" y="160" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;div&gt;(Frontend Assets Bucket&lt;br&gt;private, OAC only)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="330" y="160" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ssm" value="&lt;b&gt;AWS Systems Manager&lt;/b&gt;&lt;div&gt;(Parameter Store —&lt;br&gt;/&lt;i&gt;project&lt;/i&gt;/app-url)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1">
          <mxGeometry x="540" y="160" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;div&gt;(User Pool — SRP sign-in,&lt;br&gt;&lt;i&gt;admins&lt;/i&gt; group claim)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1">
          <mxGeometry x="120" y="390" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="custmsg" value="&lt;b&gt;Cognito Trigger&lt;/b&gt;&lt;br&gt;(Custom Message)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.lambda_function;" vertex="1" parent="1">
          <mxGeometry x="345" y="405" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="apigw" value="&lt;b&gt;Amazon API Gateway&lt;/b&gt;&lt;div&gt;(BFF REST API — stage throttle,&lt;br&gt;access logs, Cognito authorizer)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="120" y="620" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ═══════════════ BFF Lambdas ═══════════════ -->
        <mxCell id="bffchat" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div&gt;(BFF Chat — POST /chat,&lt;br&gt;streamed response)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="bffadmin" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div&gt;(BFF Admin —&lt;br&gt;/admin/users)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="330" y="700" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="bffap2" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div&gt;(BFF Checkout — the Trusted Surface:&lt;br&gt;/intent /confirm /decline /journeys&lt;br&gt;/evidence /actors)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="330" y="840" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ═══════════════ BFF-owned backing resources ═══════════════ -->
        <mxCell id="ddbbff" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;div&gt;ap2-intents (+2 GSIs)&lt;br&gt;bff-rate-limit&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="120" y="1010" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="sm" value="&lt;b&gt;AWS Secrets Manager&lt;/b&gt;&lt;div&gt;ap2-hmac-secret&lt;br&gt;(seals intents, hashes OTP)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="330" y="1010" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="snsotp" value="&lt;b&gt;Amazon SNS&lt;/b&gt;&lt;div&gt;(one-time code by SMS —&lt;br&gt;out of band, never via the agent)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="540" y="1010" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="kmsid" value="&lt;b&gt;AWS KMS&lt;/b&gt;&lt;div&gt;Caller Identity Key&lt;br&gt;(ECC_NIST_P256 / ES256)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="750" y="1010" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ═══════════════ Operations ═══════════════ -->
        <mxCell id="cw" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&lt;div&gt;(alarms: 3 BFF Lambdas + API 5XX;&lt;br&gt;log groups; X-Ray on the entities)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="1">
          <mxGeometry x="120" y="1250" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="snsalarm" value="&lt;b&gt;Amazon SNS&lt;/b&gt;&lt;div&gt;(alarm topic → e-mail;&lt;br&gt;AWS Budgets notifies the same address)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1">
          <mxGeometry x="360" y="1250" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ═══════════════ Agent ═══════════════ -->
        <mxCell id="ecr" value="&lt;b&gt;Amazon ECR&lt;/b&gt;&lt;div&gt;(Agent Container Image —&lt;br&gt;CDK DockerImageAsset)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1">
          <mxGeometry x="700" y="390" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="agentcore" value="&lt;b&gt;Amazon Bedrock AgentCore&lt;/b&gt;&lt;div&gt;(Agent Runtime — Strands agent,&lt;br&gt;SigV4 only, no authorizer)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="1">
          <mxGeometry x="700" y="560" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="tools" value="&lt;b&gt;Agent Tools&lt;/b&gt;&lt;div&gt;(propose-only)&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.sagemaker_model;" vertex="1" parent="1">
          <mxGeometry x="880" y="560" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="toolbadge" value="" style="sketch=0;aspect=fixed;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#00188D;shape=mxgraph.mscae.enterprise.tool;" vertex="1" parent="1">
          <mxGeometry x="949" y="551" width="25" height="22.5" as="geometry" />
        </mxCell>
        <mxCell id="toolstxt" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;search_products&lt;/b&gt; → Merchant&lt;br&gt;&lt;b&gt;create_merchant_cart&lt;/b&gt; → Merchant&lt;br&gt;&lt;b&gt;list_payment_methods&lt;/b&gt; → CP&lt;br&gt;&lt;b&gt;initiate_consent_session&lt;/b&gt; → Consent&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#01A88D;fillColor=none;align=left;verticalAlign=middle;rounded=1;fontSize=10;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="690" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="noteagent" value="&lt;b&gt;No authorizer on the runtime, deliberately.&lt;/b&gt; SigV4 only — the BFF Chat role is the sole holder of &lt;i&gt;bedrock-agentcore:InvokeAgentRuntime&lt;/i&gt;, so no browser can reach it and the identity block cannot be client-supplied. The agent has &lt;b&gt;no&lt;/b&gt; grant on the Mandate Authority or the MPP." style="text;html=1;whiteSpace=wrap;strokeColor=#01A88D;fillColor=none;align=left;verticalAlign=middle;rounded=1;fontSize=10;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="180" width="330" height="110" as="geometry" />
        </mxCell>

        <!-- ═══════════════ AP2 entity Lambdas ═══════════════ -->
        <mxCell id="merchant" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div&gt;(Merchant Endpoint)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;search_products, create_merchant_cart,&lt;br&gt;initiate_payment, get_payment_status&lt;/font&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1090" y="350" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="consent" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div&gt;(Consent Sessions — signs nothing)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;initiate_consent_session, get_consent_session,&lt;br&gt;poll_consent_status&lt;/font&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1090" y="520" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="mandate" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div&gt;(&lt;b&gt;Mandate Authority&lt;/b&gt;)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;submit_consent_decision — the only&lt;br&gt;kms:Sign grant on the Consent key&lt;/font&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1090" y="690" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="cp" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div&gt;(Credential Provider)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;list_payment_methods,&lt;br&gt;request_payment_credential, redeem&lt;/font&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1090" y="860" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="mpp" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div&gt;(Merchant Payment Processor)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;verifies the whole chain, then&lt;br&gt;authorizes at a simulated PSP (in-process)&lt;/font&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1030" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="evidencefn" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;div&gt;(Evidence Store — signs nothing)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;deployed; no Function URL yet —&lt;br&gt;the BFF reads the log directly&lt;/font&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1200" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ═══════════════ KMS signing keys ═══════════════ -->
        <mxCell id="kmsmerchant" value="&lt;b&gt;AWS KMS&lt;/b&gt;&lt;div&gt;Merchant key&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="1470" y="240" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="kmsconsent" value="&lt;b&gt;AWS KMS&lt;/b&gt;&lt;div&gt;Consent key&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="1470" y="590" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="kmscp" value="&lt;b&gt;AWS KMS&lt;/b&gt;&lt;div&gt;CP key&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="1470" y="750" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="kmsmpp" value="&lt;b&gt;AWS KMS&lt;/b&gt;&lt;div&gt;MPP key&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1">
          <mxGeometry x="1470" y="920" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ═══════════════ DynamoDB (AP2 state) ═══════════════ -->
        <mxCell id="ddbmerchant" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;div&gt;merchant-catalog&lt;br&gt;merchant-carts&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1720" y="350" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ddbconsent" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;div&gt;consent-sessions&lt;br&gt;mandates&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1720" y="520" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ddbcp" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;div&gt;payment-methods-registry&lt;br&gt;payment-credentials&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(+ anti-replay markers)&lt;/font&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="1720" y="860" width="78" height="78" as="geometry" />
        </mxCell>
