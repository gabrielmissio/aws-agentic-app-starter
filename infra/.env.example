# Global Config
AWS_REGION=us-east-1
PROJECT_NAME=agentic-app-template

# Everything below is optional. The ones marked "Gated" are refused by DEPLOY_PROFILE=pilot|prod:
# the synth fails naming each one and why, so that reasoning is not repeated here.

# ── Platform ─────────────────────────────────────────────────────────────────
# Docker platform for the agent image. Defaults to the AgentCore target, linux/arm64 — on a non-arm64
# machine run `npm run docker:setup-arm64` first. Accepts linux/amd64, or "current" to build native.
AGENT_IMAGE_PLATFORM="linux/arm64"

# ── Deployment profile ───────────────────────────────────────────────────────
# What this deployment is for, which decides what everything below may be:
#   demo   (default) a disposable sandbox — every convenience default here is permitted.
#   pilot  real people and real data — `cdk synth` FAILS on any sandbox default still set.
#   prod   everything pilot requires.
DEPLOY_PROFILE="demo"

# The account and region this stack belongs in. Unset, `cdk deploy` targets whatever credentials are
# in the shell; set, a mismatch fails the synth before a resource is described. Gated.
# DEPLOY_ACCOUNT="123456789012"
# DEPLOY_REGION="us-east-1"

# Second factor: off | optional | required. Default off. Gated.
#
# An authenticator app (TOTP) only — nothing here collects a phone number, so SMS would be a factor
# no user could enroll in. The modes differ in where enrollment happens: `required` enrolls at
# sign-in, `optional` leaves it to the user menu's two-factor panel, `off` offers neither.
# COGNITO_MFA="required"

# Cognito threat protection: off | audit | enforced. Default off — anything else moves the pool onto
# the Cognito PLUS feature plan, which is BILLED PER MONTHLY ACTIVE USER. Gated.
# COGNITO_THREAT_PROTECTION="audit"

# A WAF web ACL on the API stage: AWS managed rule groups plus a per-IP rate rule. Off in every
# profile, the gate included, because it bills per ACL, per rule and per million requests.
# Recommended for an internet-facing pilot even so: it is the only layer that filters *before*
# authentication, which neither the stage throttle nor the per-caller quota can.
# WAF_ENABLED=true

# A Bedrock guardrail on model input and output: content filters, prompt-attack detection, and PII
# anonymization. Off by default because it bills per text unit processed. GATED — a pilot or prod
# deployment refuses to synthesize without it, because nothing else in this stack reads what is said:
# IAM bounds who may call the model and the system prompt asks it to behave, but neither filters
# content, redacts an identifier, nor recognizes an injection.
# GUARDRAIL_ENABLED=true

# X-Ray on the three Lambdas and the API stage. Off by default because it bills per trace recorded.
# GATED — without it, the browser, the BFF and the agent share nothing but a timestamp, and a wrong
# answer in a pilot is not reconstructable. The agent container is covered separately, by
# AGENT_OBSERVABILITY_ENABLED below.
# TRACING_ENABLED=true

# Spans and token/tool metrics from inside the agent container. GATED, and a separate bill from
# TRACING_ENABLED: that one buys X-Ray on the Lambdas and the stage, this one buys the layer where
# the tool calls, the token counts and the time-to-first-token actually are.
#
# The variable name is AgentCore's own and is passed to the container unchanged, so what switches
# telemetry on in the stack and what switches it on in the runtime cannot drift apart. Turning it on
# also creates the agent's telemetry log group, its data protection policy, and the three vended-log
# deliveries the CloudWatch GenAI Observability console reads.
# AGENT_OBSERVABILITY_ENABLED=true

# An ACKNOWLEDGEMENT, not a switch. GATED under pilot/prod.
#
# CloudWatch Transaction Search is the prerequisite for every span above, and it is account-and-
# Region-wide state that other workloads also depend on. This template deliberately does not create
# it: a `cdk destroy` here must not be able to switch off their telemetry, and its indexing
# percentage is a billing decision belonging to whoever owns the account.
#
# It is gated anyway because it fails SILENTLY — without it, spans are accepted and then discarded,
# so the deployment looks healthy and the traces simply never appear. Enable it once per account and
# Region, then set this to say you did:
#
#   aws xray update-trace-segment-destination --destination CloudWatchLogs --region <your region>
#   aws xray get-trace-segment-destination --region <your region>
#
# The second command must report BOTH `CloudWatchLogs` and `ACTIVE` before you deploy. If the deploy
# fails on a delivery destination, see "X-Ray Delivery Destination is supported with CloudWatch Logs"
# in infra/README.md's Troubleshooting.
#
# TRANSACTION_SEARCH_ENABLED=true

# How long a recorded conversation is kept, in days. GATED, and deliberately with NO default under a
# regulated profile: "how long do you keep what people typed" is the first question a pilot is asked,
# and a number this template picked would be an answer nobody chose. Sets `eventExpiryDuration` on
# the AgentCore Memory resource — enforced by the service, not by a job that might not run — and the
# TTL on the conversation index rows, so the two expire together. It also sets the retention on the
# agent's telemetry log group, so a trace never outlives the turn it describes.
# CONVERSATION_RETENTION_DAYS=30

# How many past messages are replayed into a new turn. Each turn re-sends the context it is given, so
# an uncapped history makes a long conversation cost more with every message. Default 40.
# MEMORY_MAX_MESSAGES=40

# The Bedrock model the agent invokes. Its execution role is scoped to THIS model and no other, so
# changing it here moves the configuration and the permission together.
#
# The `us.` prefix is a cross-region inference profile tied to a geography: requests are processed in
# US Regions only, and the source Region has to be one of them — deploying to Europe or APAC means
# `eu.`/`apac.`. `global.` routes to any commercial Region worldwide for roughly 10% less, which is a
# data-residency decision, not a cost one.
#
# Whichever model you name has to have a Marketplace agreement in the target account, and the first
# deploy of this template never does. The symptom is a green deploy whose first chat message fails —
# see "Model access is denied" in README.md, which also explains why the fix does not belong in IAM.
# BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-5"

# ── Sign-up mode ─────────────────────────────────────────────────────────────
# true (default): visitors create their own account. false: invite-only — self sign-up is disabled at
# the pool itself, an operator creates every account (see infra/README.md), and the user picks a
# password on first sign-in. Gated.
PUBLIC_SIGNUP_ENABLED="true"

# Canonical app URL, linked from the invite and confirmation emails. Optional: unset, they link to
# whatever the frontend stack last published to SSM, so a fresh `cdk deploy --all` needs no manual
# step. Set it once there is a real domain; it wins either way.
# APP_URL="https://app.example.com"

# ── Operations ───────────────────────────────────────────────────────────────
# Whether the user pool and the frontend bucket survive `cdk destroy`. Set false only for an
# environment you intend to throw away. Gated.
RETAIN_DATA=true

# Address subscribed to the CloudWatch alarms and the budget. They fire either way — without this
# nobody is notified. Gated.
# ALERT_EMAIL="ops@example.com"

# Monthly USD ceiling, notifying at 80% and 100%. Needs ALERT_EMAIL. A budget alerts; it cannot stop
# spend. It also measures the WHOLE ACCOUNT rather than this project, despite being named after it —
# there is no cost filter on it. Set the account's ceiling, or leave it unset in a shared account
# where a project-sized ceiling would alert at 100% from day one.
# MONTHLY_BUDGET_USD=200

# Requests/second on the API stage, and the burst above it. Unset, the stage inherits the account's
# 10k rps, and every request downstream costs Bedrock tokens.
# API_RATE_LIMIT=10
# API_BURST_LIMIT=20

# Browser origin allowed to call the BFF (CORS). Defaults to "*" because the frontend's CloudFront
# URL does not exist yet on a first `cdk deploy --all`. Set it and redeploy the bff stack once it
# does. Gated.
# ALLOWED_ORIGIN="https://app.example.com"

# Calls one signed-in caller gets per window, and the window in seconds. API_RATE_LIMIT bounds the
# whole account; this bounds a single caller within it, so one careless or compromised account
# cannot consume everyone else's share.
# USER_RATE_LIMIT=20
# USER_RATE_LIMIT_WINDOW_SECONDS=60
