# Global Config
AWS_REGION=us-east-1
PROJECT_NAME=agentic-payments-template

# Additional setup options

# ── Platform ─────────────────────────────────────────────────────────────
# Agent image platform used by the CDK Docker asset.
# Default is linux/arm64 to match the Bedrock AgentCore runtime target.
# On non-arm64 machines, install emulation first:
#   npm run docker:setup-arm64
# You can also set this to linux/amd64 or current for local troubleshooting.
AGENT_IMAGE_PLATFORM="linux/arm64"

# ── Deployment profile ───────────────────────────────────────────────────────
# What this deployment is for. It decides what everything below is ALLOWED to be.
#
#   demo   (default) a disposable sandbox: synthetic data, no real money, no real people.
#          Every convenience default below is permitted.
#   pilot  real people and real data, simulated processor. `cdk synth` FAILS if any sandbox
#          default is still set — see the list the error prints.
#   prod   everything pilot requires, plus no auto-provisioned sandbox instrument.
#
# The defaults in this file are chosen to make the template easy to try, and each is documented as
# sandbox-only. That documentation is the control that fails: whoever copies this repo to run a
# pilot is not whoever read the comment. This turns those notes into a build that refuses.
DEPLOY_PROFILE="demo"

# The account and region this stack belongs in. Unset, nothing is checked — `cdk deploy` targets
# whatever credentials are in the shell, which is fine for a sandbox. Set, a mismatch fails the
# synth before a single resource is described.
#
# REQUIRED under DEPLOY_PROFILE=pilot or prod: the difference between deploying to a scratch account
# and to the one holding real user data should not be which AWS_PROFILE was exported last.
# DEPLOY_ACCOUNT="123456789012"
# DEPLOY_REGION="us-east-1"

# Second factor on the user pool: off | optional | required. Default off, so a reviewer is not made
# to enroll an authenticator before seeing the demo. `pilot` and `prod` require "required": an
# account here approves payments and reads a purchase history, and "optional" in practice means
# most people never enroll.
#
# The factor is an AUTHENTICATOR APP (TOTP) — Google Authenticator, 1Password, Authy. SMS is NOT
# offered: nothing in this application collects a phone number, so it would be a factor no user
# could enroll in.
#
# All three modes are handled end to end:
#   off       no second factor, and the app shows no enrollment entry at all.
#   optional  Cognito never asks anyone to enroll, so the app offers it: the user menu has a
#             "two-factor authentication" panel to opt in, and to turn it back off.
#   required  the sign-in screen enrolls the user on the spot, via the TOTP setup challenge. The
#             panel then only confirms it; Cognito refuses to remove the last factor.
#
# This is Cognito's SIGN-IN factor. It is not the checkout step-up code, which is the BFF's own.
#
# BEFORE setting this to required: the sign-in screen must handle the TOTP enrollment challenge.
# It currently handles only NEW_PASSWORD_REQUIRED, so users with no factor enrolled would be shown
# "unsupported step" and be unable to sign in.
# COGNITO_MFA="required"

# Cognito threat protection: off | audit | enforced. Default off, because anything else moves the
# pool onto the Cognito PLUS feature plan, which is BILLED PER MONTHLY ACTIVE USER. `pilot` and
# `prod` refuse "off" — so the cost is a decision someone makes, not a surprise on the invoice.
# COGNITO_THREAT_PROTECTION="audit"

# A WAF web ACL in front of the API stage: AWS managed rule groups plus a per-IP rate rule.
#
# OFF by default in every profile, including pilot and prod — a web ACL is billed per ACL, per rule
# and per million requests, and the right rules depend on the traffic a deployment actually sees.
# The profile gate does not require it.
#
# RECOMMENDED for an internet-facing pilot: it is the only layer here that filters traffic *before*
# authentication. The stage throttle bounds the whole account without saying who spent it, and the
# per-caller quota is keyed on an authenticated `sub`, so neither sees an unauthenticated flood or
# a scripted sign-up run.
# WAF_ENABLED=true

# The Bedrock model the agent invokes. The agent's execution role is scoped to THIS model and no
# other, so changing it here changes both the configuration and the permission together.
# BEDROCK_MODEL_ID="global.anthropic.claude-sonnet-4-6"

# ── Sign-up mode ─────────────────────────────────────────────────────────────
# true:  visitors can create their own account from the auth screen (default —
#        lowest friction for trying the template).
# false: invite-only. Self sign-up is disabled at the Cognito pool level; an
#        operator provisions every account with `aws cognito-idp admin-create-user`
#        (see infra/README.md), and the user sets their own password on first
#        sign-in via the NEW_PASSWORD_REQUIRED challenge.
#
# Must be false under DEPLOY_PROFILE=pilot or prod: open sign-up lets anyone mint accounts, which
# defeats the per-user quotas and puts strangers on a deployment holding real data.
PUBLIC_SIGNUP_ENABLED="true"

# Canonical URL of the app, linked from the invite and sign-up-confirmation emails. Optional: unset,
# the emails link to whatever URL the frontend stack published to SSM on its last deploy — which is
# enough for a fresh `cdk deploy --all` to produce working, linked emails with no manual step. Set
# this once there is a real domain (it wins over the SSM value either way).
# APP_URL="https://app.example.com"

# ── Pilot / production guardrails ───────────────────────────────────────────────
# Whether the user pool and the frontend bucket survive `cdk destroy`. Defaults to true: losing
# every account is irreversible, an orphaned pool/bucket is not. Set false for a disposable environment.
RETAIN_DATA=true # (for dev/test environments, set to false to destroy the user pool and S3 bucket on `cdk destroy`)

# Address subscribed to the CloudWatch alarms and the budget. The alarms exist either way —
# without this nobody is notified when they fire.
# ALERT_EMAIL="ops@example.com"

# Monthly USD ceiling that triggers a budget notification at 80% and 100%. Needs ALERT_EMAIL.
# A budget alerts, it cannot stop spend — it exists so a runaway loop is noticed in hours.
# MONTHLY_BUDGET_USD=200

# Requests/second allowed on the API stage, and the burst above it. Unset, the stage would
# inherit the 10k rps account default, and every request downstream costs Bedrock tokens.
# API_RATE_LIMIT=10
# API_BURST_LIMIT=20

# Browser origin allowed to call the BFF (CORS). Defaults to "*": the frontend's CloudFront URL
# isn't known yet on a first `cdk deploy --all` (FrontendStack depends on BffStack, not the other
# way around), so there's no single real origin to lock this to before that first deploy. Once you
# know the app's real origin (a custom domain, or the CloudFront URL printed by that first deploy),
# set it here and redeploy the BFF stack to close CORS down to just that origin.
# ALLOWED_ORIGIN="https://app.example.com"

# Requests one signed-in caller gets per window, and the window length in seconds. Independent of
# API_RATE_LIMIT above: that one bounds the whole account, this one bounds a single caller, so one
# compromised or careless account can't consume every other caller's share of it. Default 20 per 60s.
# USER_RATE_LIMIT=20
# USER_RATE_LIMIT_WINDOW_SECONDS=60

# The same, for /intent, /confirm and /decline — the routes that move money. Metered under its own
# key, so a conversation cannot spend the checkout budget or the reverse, and tighter because a
# normal checkout is two or three calls. Default 10 per 60s. The read routes are not metered: they
# are self-scoped and the Explorer polls them.
# AP2_RATE_LIMIT=10
# AP2_RATE_LIMIT_WINDOW_SECONDS=60
# ── AP2 ─────────────────────────────────────────────────────────────────────────
# The MPP identities the Credential Provider will scope a payment credential to. The CP refuses to
# issue one naming an MPP outside this list, so this is what makes "settles through a processor we
# chose" enforceable rather than assumed. Comma-separated.
# ALLOWED_MPPS=mpp-sandbox-001

# Mint a sandbox payment method for a user who has none, on first listing. Defaults to true: a
# brand-new account otherwise reaches checkout with nothing to pay with, which reads as broken
# rather than empty. Set false where methods are provisioned deliberately.
# AUTO_PROVISION_SANDBOX_METHOD=true

# Cart total, in minor units, at or above which checkout requires an OTP step-up. Below it, an
# authenticated one-tap confirm on an HMAC-sealed intent is the approval. 0 means always step up.
# Default 10000 (R$100.00).
#
# IMPORTANT: a step-up is only offered when a code can actually be delivered. The code goes out by
# SMS to the `phone_number` claim, and this user pool does not collect one — so unless
# OTP_REVEAL_IN_UI is on, /intent refuses any checkout at or above this threshold with
# `stepUpUnavailable` rather than opening a code field nobody can fill. Raise the threshold, enable
# the sandbox reveal, or add a real step-up channel.
# OTP_STEPUP_THRESHOLD_CENTS=10000

# How long a user has to authorize a proposed checkout before the intent expires, in minutes. This
# bounds the window in which a signed cart, a sealed intent and a one-time code are simultaneously
# valid — a security parameter, not just a UX one. Default 5.
# INTENT_TTL_MIN=5

# Return the real one-time code in the /intent response so the UI can display it. Strictly a sandbox
# convenience: SNS SMS in the sandbox only reaches verified numbers, so without this a reviewer with
# no verified phone cannot complete a checkout. Verification is unchanged — the displayed code is the
# genuine one and is still checked server-side.
#
# Must be false under DEPLOY_PROFILE=pilot or prod, and the synth refuses it there rather than
# trusting this comment: returning the code on the same channel that asked for it proves possession
# of nothing, so the step-up becomes decoration — while the signed mandate says a step-up happened.
OTP_REVEAL_IN_UI=true
