{
  "name": "infra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cdk": "cdk",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:dependencies",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:setup-arm64": "docker run --privileged --rm tonistiigi/binfmt --install arm64",
    "build:dependencies": "npm --prefix ../chatbot-bff run build && npm --prefix ../chatbot-frontend run build",
    "presynth": "npm run build:dependencies",
    "synth": "dotenvx run -f .env --overload -- cdk synth",
    "predeploy": "npm run build:dependencies",
    "deploy": "dotenvx run -f .env --overload -- cdk deploy --all --require-approval broadening",
    "predeploy:no-approval": "npm run build:dependencies",
    "deploy:no-approval": "dotenvx run -f .env --overload -- cdk deploy --all --require-approval never",
    "destroy": "dotenvx run -f .env --overload -- cdk destroy --all",
    "deploy:agent": "dotenvx run -f .env --overload -- sh -c 'cdk deploy \"$PROJECT_NAME-agent\" --require-approval broadening'",
    "predeploy:bff": "npm --prefix ../chatbot-bff run build",
    "deploy:bff": "dotenvx run -f .env --overload -- sh -c 'cdk deploy \"$PROJECT_NAME-bff\" --require-approval broadening'"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.6.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "@types/node": "^25.6.0",
    "aws-cdk": "^2.1135.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
