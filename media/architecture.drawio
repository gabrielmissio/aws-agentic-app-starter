        <mxCell id="lg2t" value="Response — 10: SSE streamed back along the same path" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3B4A57;" vertex="1" parent="1">
          <mxGeometry x="740" y="1212" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="1222" as="sourcePoint" />
