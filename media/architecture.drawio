        <mxCell id="e16" value="invite / verification email&lt;br&gt;en-US · pt-BR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#5A6C7D;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.83;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_msgfn" target="n_user">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="255" y="904" />
              <mxPoint x="255" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e17" value="alarm &#8594; topic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#5A6C7D;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_cw" target="n_sns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="10 · SSE re-streamed to the browser (text/event-stream) — the same path in reverse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#00A4A6;strokeWidth=2;dashed=1;dashPattern=1 3;fontSize=10;fontColor=#00747A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_runtime" target="n_user">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1400" y="400" />
              <mxPoint x="160" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note_frontend" value="&lt;b&gt;Delivery &amp; browser hardening&lt;/b&gt;&lt;br&gt;• Response headers policy: CSP with script-src 'self', HSTS 1 y preload, nosniff, frame-ancestors 'none'&lt;br&gt;• SPA fallback: 403/404 &#8594; index.html&lt;br&gt;• config.js is written at deploy time — no pool id baked into the bundle&lt;br&gt;• assets immutable, index.html no-cache" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#B3C0CC;align=left;verticalAlign=top;spacing=8;fontSize=9;fontColor=#3B4A57;" vertex="1" parent="1">
          <mxGeometry x="445" y="415" width="185" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note_auth" value="&lt;b&gt;No Identity Pool — deliberately&lt;/b&gt;&lt;br&gt;The browser holds a JWT and never AWS credentials.&lt;br&gt;&lt;br&gt;• Client: SRP only, no secret&lt;br&gt;• ID/access token 1 h · refresh 30 d&lt;br&gt;• Group &lt;i&gt;admins&lt;/i&gt; arrives as a claim (no trigger)&lt;br&gt;• TOTP only — no phone attribute, so no SMS&lt;br&gt;• Self sign-up: PUBLIC_SIGNUP_ENABLED" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#B3C0CC;align=left;verticalAlign=top;spacing=8;fontSize=9;fontColor=#3B4A57;" vertex="1" parent="1">
          <mxGeometry x="445" y="835" width="185" height="145" as="geometry" />
        </mxCell>
        <mxCell id="note_ops" value="Operational guardrails" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#D05C17;" vertex="1" parent="1">
          <mxGeometry x="700" y="565" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="note_bff" value="&lt;b&gt;Two functions, two roles — on purpose&lt;/b&gt;&lt;br&gt;The function that relays model output must not be the one that can create accounts: only the admin role holds cognito-idp:AdminCreateUser, scoped to this pool and to four actions.&lt;br&gt;&lt;br&gt;&lt;b&gt;Three independent limits&lt;/b&gt;&lt;br&gt;• Stage throttle — API_RATE_LIMIT / API_BURST_LIMIT (10 / 20 rps) bounds the account&lt;br&gt;• Per-caller quota — USER_RATE_LIMIT (20 / 60 s), keyed on the verified sub, in DynamoDB with a TTL&lt;br&gt;• WAF per-IP rate rule — the only layer that filters &lt;i&gt;before&lt;/i&gt; authentication&lt;br&gt;&lt;br&gt;&lt;b&gt;Logging&lt;/b&gt; Access logs record identity and outcome, never payloads (dataTraceEnabled stays off). 1-month retention on every log group." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#B3C0CC;align=left;verticalAlign=top;spacing=8;fontSize=9;fontColor=#3B4A57;" vertex="1" parent="1">
          <mxGeometry x="700" y="755" width="480" height="235" as="geometry" />
        </mxCell>
        <mxCell id="callout_boundary" value="&lt;b&gt;⚠&#160; SigV4 only — the browser has no path here&lt;/b&gt;&lt;br&gt;&lt;br&gt;The runtime carries &lt;b&gt;no authorizerConfiguration&lt;/b&gt;, and the chat function's execution role is the sole principal granted bedrock-agentcore:InvokeAgentRuntime.&lt;br&gt;&lt;br&gt;The agent learns who is asking from a &lt;b&gt;plain-text identity block&lt;/b&gt; the BFF prepends to the prompt, built from claims the authorizer verified. It is trustworthy only because the BFF is the only writer — a direct browser path would make it a request body any signed-in user could compose.&lt;br&gt;&lt;br&gt;Asserted in infra/src/__tests__/stacks.test.ts: no identity pool, no role federated to Cognito, nothing else granted InvokeAgentRuntime." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF2F2;strokeColor=#C7131F;strokeWidth=2;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacing=8;fontSize=9;fontColor=#7A0C16;" vertex="1" parent="1">
          <mxGeometry x="1260" y="555" width="520" height="185" as="geometry" />
        </mxCell>
        <mxCell id="note_agent" value="&lt;b&gt;Runtime execution role — least privilege&lt;/b&gt;&lt;br&gt;• ecr:BatchGetImage / GetDownloadUrlForLayer on &lt;i&gt;this repository only&lt;/i&gt;&lt;br&gt;• logs limited to /aws/bedrock-agentcore/runtimes/*&lt;br&gt;• cloudwatch:PutMetricData confined to the bedrock-agentcore namespace · X-Ray traces&lt;br&gt;• bedrock:InvokeModel scoped to one foundation-model ARN &lt;i&gt;plus&lt;/i&gt; its inference profile — a wildcard would be a budget with no ceiling and a data path with no boundary&lt;br&gt;&lt;br&gt;&lt;b&gt;Runtime configuration&lt;/b&gt;&#160; network PUBLIC · protocol HTTP · idle session 900 s · max lifetime 4 h · /invocations + /ping&lt;br&gt;&lt;br&gt;&lt;b&gt;Tools (in-process, Strands)&lt;/b&gt;&#160; get_current_time, get_signed_in_user. &lt;b&gt;No tool takes a user id&lt;/b&gt; — identity comes from the request scope, asserted over the whole toolset." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#B3C0CC;align=left;verticalAlign=top;spacing=8;fontSize=9;fontColor=#3B4A57;" vertex="1" parent="1">
          <mxGeometry x="1260" y="760" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="callout_gate" value="&lt;b&gt;Deployment-profile gate — DEPLOY_PROFILE=pilot|prod makes &lt;i&gt;cdk synth&lt;/i&gt; refuse a stack still carrying sandbox defaults (infra/src/config.ts), before a single resource is described&lt;/b&gt;&lt;br&gt;PUBLIC_SIGNUP_ENABLED=false&#160; ·&#160; ALLOWED_ORIGIN pinned to the app origin&#160; ·&#160; ALERT_EMAIL set&#160; ·&#160; COGNITO_MFA=required&#160; ·&#160; COGNITO_THREAT_PROTECTION=audit|enforced (moves the pool to the Plus plan, billed per MAU)&#160; ·&#160; RETAIN_DATA=true&#160; ·&#160; DEPLOY_ACCOUNT + DEPLOY_REGION pinned&lt;br&gt;WAF stays opt-in in every profile — it bills per ACL, per rule and per million requests, and a gate that forces recurring spend is one people work around. Every violation is reported at once. &lt;i&gt;demo&lt;/i&gt; is unchecked on purpose." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D9A400;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#6B5200;" vertex="1" parent="1">
          <mxGeometry x="300" y="1040" width="1500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="legend_box" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3C0CC;" vertex="1" parent="1">
          <mxGeometry x="240" y="1200" width="1620" height="100" as="geometry" />
        </mxCell>
        <mxCell id="legend_title" value="Legend" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="258" y="1212" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="1">
