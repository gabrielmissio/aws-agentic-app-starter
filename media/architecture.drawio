          </mxGeometry>
        </mxCell>
        <mxCell id="lg3t" value="Configuration, trigger or build-time dependency" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3B4A57;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1212" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="" style="endArrow=none;html=1;strokeColor=#C7131F;strokeWidth=2;dashed=1;dashPattern=4 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1480" y="1222" as="sourcePoint" />
            <mxPoint x="1540" y="1222" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg4t" value="Trust boundary" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3B4A57;" vertex="1" parent="1">
          <mxGeometry x="1550" y="1212" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg5t" value="&lt;b&gt;Grouping&lt;/b&gt;&#160; AWS Cloud &#8594; Region &#8594; one dashed box per CDK stack, coloured by its lead service category (violet frontend · red auth · orange BFF · teal agent). Stack names carry the PROJECT_NAME prefix from infra/.env.&lt;br&gt;&lt;b&gt;Opt-in&lt;/b&gt;&#160; WAF, the account budget and Cognito threat protection are off by default and each bills separately; everything else is deployed by &lt;i&gt;npm run deploy&lt;/i&gt;. &lt;b&gt;Not shown&lt;/b&gt;&#160; there is no VPC, no NAT and no deploy pipeline — deployment runs from a developer machine against whatever credentials are in the shell." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#3B4A57;" vertex="1" parent="1">
          <mxGeometry x="258" y="1240" width="1580" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
