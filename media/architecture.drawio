        <mxCell id="lg2" value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#00A4A6;strokeWidth=2;dashed=1;dashPattern=1 3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
